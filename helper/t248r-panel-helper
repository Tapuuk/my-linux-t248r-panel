def driver_of(path):
    link = f"{path}/driver"
    return os.path.basename(os.path.realpath(link)) if os.path.exists(link) else None


def wait_for(cond, seconds, interval=0.25):
    end = time.monotonic() + seconds
    while True:
        if cond():
            return True
        if time.monotonic() >= end:
            return False
        time.sleep(interval)


# ---------------------------------------------------------------- package managers

APT_ENV = {"DEBIAN_FRONTEND": "noninteractive", "NEEDRESTART_SUSPEND": "1"}
_apt_updated = False

NET_PATTERNS = ("could not resolve", "temporary failure resolving", "failed retrieving file",
                "failed to download", "curl error", "cannot download", "network is unreachable",
                "connection timed out", "could not connect", "failed to synchronize")


def _pacman_lock_wait():
    lock = "/var/lib/pacman/db.lck"
    if DRY or not os.path.exists(lock):
        return
    log("Another package manager is running. Waiting for it to finish...")
    if not wait_for(lambda: not os.path.exists(lock), 60, 1):
        raise Fail("pacman is locked (/var/lib/pacman/db.lck). Close any other package manager and "
                   "try again. If nothing else is running, a crash left the lock behind: delete that "
                   "file, then retry.")


def _pm_failure(family, rc, lines):
    text = "\n".join(lines[-60:]).lower()
    if any(p in text for p in NET_PATTERNS):
        hint("no-network", "Could not download packages. Check your internet connection and try again.")
        return "Downloading packages failed. Check your internet connection."
    if family == "arch":
        if "unable to lock database" in text:
            return ("pacman is locked (/var/lib/pacman/db.lck). Close any other package manager and "
                    "try again.")
        if "target not found" in text:
            return "pacman could not find a package. Update your system (pacman -Syu), restart, then try again."
    if family == "debian":
        if "could not get lock" in text or "unable to acquire the dpkg frontend lock" in text \
                or "unable to lock the administration directory" in text:
            return "Another program is installing software (apt is locked). Wait for it to finish, then try again."
        if "dpkg was interrupted" in text:
            return "A previous install was interrupted. Run 'sudo dpkg --configure -a', then try again."
        if "unable to locate package" in text:
            return "apt could not find a package. Update your system, restart, then try again."
    if family == "suse" and "system management is locked" in text:
        return "Another program is using zypper. Wait for it to finish, then try again."
    if family == "fedora" and "no match for argument" in text:
        return "dnf could not find a package. Update your system, restart, then try again."
    return f"The package manager failed (exit code {rc}). The log above has the details."


def pm_install(family, pkgs):
    """Install packages non-interactively. Returns None on success, else an error message."""
    global _apt_updated
    env = None
    if family == "arch":
        _pacman_lock_wait()
        cmd = ["pacman", "-S", "--needed", "--noconfirm"] + pkgs
    elif family == "debian":
        env = APT_ENV
        if not _apt_updated:
            rc, lines = run(["apt-get", "update"], env=env)
            if rc != 0:
                return _pm_failure(family, rc, lines)
            _apt_updated = True
        cmd = ["apt-get", "install", "-y", "-o", "DPkg::Lock::Timeout=120",
               "-o", "Dpkg::Options::=--force-confdef", "-o", "Dpkg::Options::=--force-confold"] + pkgs
    elif family == "fedora":
        cmd = ["dnf", "install", "-y"] + pkgs
    elif family == "suse":
        env = {"ZYPP_LOCK_TIMEOUT": "60"}
        cmd = ["zypper", "--non-interactive", "install"] + pkgs
    else:
        return "No package manager for this system."
    rc, lines = run(cmd, env=env)
    return None if rc == 0 else _pm_failure(family, rc, lines)


def headers_package(family):
    """Returns (package names to try in order) for the running kernel's headers."""
    if family == "arch":
        moddir = f"/usr/lib/modules/{KVER}"
        if not os.path.isdir(moddir):
            hint("reboot", "Your kernel was updated since the last restart. Restart your computer, "
                 "then run setup again.")
            raise Fail("The running kernel's files are gone because the kernel was updated. Restart first.")
        base = read(f"{moddir}/pkgbase")
        if not base or not re.fullmatch(r"[a-z0-9][a-z0-9._+-]*", base):
            raise Fail(f"Could not tell which kernel package you run ({KVER}). "
                       "Install its headers package yourself, then try again.")
        return [base + "-headers"]
    if family == "debian":
        return ["linux-headers-" + KVER]
    if family == "fedora":
        return ["kernel-devel-" + KVER, "kernel-devel"]
    if family == "suse":
        m = re.search(r"-([a-z0-9]+)$", KVER)
        flavor = m.group(1) if m and not m.group(1).isdigit() else "default"
        return [f"kernel-{flavor}-devel"]
    return []


# ---------------------------------------------------------------- driver state

_DKMS_LINE = re.compile(
    r"^([^,/\s]+)[/,]\s*([^,:\s]+)(?:,\s*([^,:\s]+))?(?:,\s*([^,:\s]+))?:\s*([a-z-]+)", re.I)


def dkms_status():
    """List of (version, kernel or None, state) for hid-tmff2 entries."""
    if not which("dkms"):
        return []
    _, out = query(["dkms", "status", "-m", DKMS_NAME], env={"LC_ALL": "C"})
    res = []
    for line in out.splitlines():
        m = _DKMS_LINE.match(line.strip())
        if m and m.group(1) == DKMS_NAME:
            res.append((m.group(2), m.group(3), m.group(5).lower()))
    return res


def src_dir(ver):
    return f"/usr/src/{DKMS_NAME}-{ver}"


def is_ours(ver):
    return os.path.exists(os.path.join(src_dir(ver), MARKER))


def our_dkms_versions():
    vers = {os.path.basename(p)[len(DKMS_NAME) + 1:]
            for p in glob.glob(f"/usr/src/{DKMS_NAME}-*") if os.path.exists(os.path.join(p, MARKER))}
    return sorted(vers)


def module_path():
    rc, out = query(["modinfo", "-k", KVER, "-n", MODULE])
    out = out.strip()
    return out if rc == 0 and out.startswith("/") else None


def plain_dir(kver=None):
    return f"/lib/modules/{kver or KVER}/{PLAIN_SUBDIR}"


def foreign_driver():
    """Describe an hid-tmff2 for the running kernel that this app did not install, or None."""
    installed = [ver for ver, kern, state in dkms_status() if kern == KVER and state == "installed"]
    for ver in installed:
        if not is_ours(ver):
            return f"DKMS module {DKMS_NAME} {ver}"
    if installed:
        return None
    path = module_path()
    if not path:
        return None
    real = os.path.realpath(path)
    if real.startswith(os.path.realpath(plain_dir()) + "/") or "/updates/dkms/" in real:
        return None
    return path


# ---------------------------------------------------------------- steps

def check_immutable_for_install():
    reason = detect_immutable()
    if not reason:
        return False
    if module_path() or os.path.isdir(MODULE_SYS):
        return True
    hint("immutable", f"This app can't install the driver here: {reason}. "
         "Use a system image that already includes hid-tmff2, or install it the way your system expects.")
    raise Fail("The system is read-only, so the driver can't be installed.")


def do_tools():
    global DRY_HAS_DKMS
    family = detect_family()
    if check_immutable_for_install():
        return "skipped", "The driver is already part of your system. Nothing to install."

    missing = [t for t in ("git", "make", "gcc") if not which(t)]
    need_dkms = not which("dkms")
    need_headers = not os.path.isdir(build_dir())
    clang = kernel_is_clang()
    need_clang = clang and not (which("clang") and which("ld.lld"))

    if not (missing or need_dkms or need_headers or need_clang):
        return "skipped", "Build tools and kernel headers are already installed."

    if family == "unknown":
        if not (missing or need_headers or need_clang):
            log("DKMS is not installed. The driver will be built without it.")
            return "skipped", "Build tools are already installed."
        hint("unsupported", "Your distro isn't one this app knows. Install git, make, gcc, dkms and the "
             f"headers for kernel {KVER} yourself, then run setup again.")
        raise Fail("Can't install build tools on this distro automatically.")

    pkgs = []
    if family == "debian":
        if "git" in missing:
            pkgs.append("git")
        if "make" in missing or "gcc" in missing:
            pkgs.append("build-essential")
    else:
        pkgs += missing
    if need_clang:
        pkgs += ["clang", "llvm", "lld"]

    if need_headers:
        candidates = headers_package(family)
        log("Installing headers for kernel " + KVER)
        err = None
        for i, pkg in enumerate(candidates):
            err = pm_install(family, pkgs + [pkg])
            if err is None:
                break
            if i + 1 < len(candidates):
                log(f"{pkg} is not available, trying {candidates[i + 1]}")
        if err:
            raise Fail(err)
        pkgs = []
    if pkgs:
        err = pm_install(family, pkgs)
        if err:
            raise Fail(err)

    if need_dkms:
        err = pm_install(family, ["dkms"])
        if err:
            log("DKMS is not available here. The driver will be built without it, "
                "so it has to be built again after each kernel update.")
        elif DRY:
            DRY_HAS_DKMS = True

    if DRY:
        return "done", "Build tools would be installed (dry run)."
    still = [t for t in ("git", "make", "gcc") if not which(t)]
    if still:
        raise Fail("These tools are still missing: " + ", ".join(still))
    if not os.path.isdir(build_dir()):
        hint("reboot", "The installed kernel headers don't match the running kernel. "
             "Update your system, restart your computer, then run setup again.")
        raise Fail(f"Headers for kernel {KVER} are still missing ({build_dir()}).")
    return "done", "Build tools and kernel headers are installed."


def has_dkms():
    return bool(which("dkms")) or (DRY and DRY_HAS_DKMS)


def prepare_work_dir():
    # /var/tmp is world-writable, so never trust what is already there.
    if os.path.lexists(WORK_DIR):
        remove_path(WORK_DIR)
    if DRY:
        dry(f"create {WORK_DIR} (mode 700)")
        return
    try:
        os.mkdir(WORK_DIR, 0o700)
    except OSError as e:
        raise Fail(f"Could not create the work folder {WORK_DIR}: {e.strerror}")
    st = os.lstat(WORK_DIR)
    if st.st_uid != 0 or not os.path.isdir(WORK_DIR) or os.path.islink(WORK_DIR):
        raise Fail(f"Could not create a safe work folder at {WORK_DIR}.")


def fetch_driver():
    """Clone the pinned commit. Returns the clone path."""
    prepare_work_dir()
    dest = os.path.join(WORK_DIR, DKMS_NAME)
    genv = {"GIT_TERMINAL_PROMPT": "0", "GIT_CONFIG_NOSYSTEM": "1", "HOME": WORK_DIR, "LC_ALL": "C"}
    log("Downloading hid-tmff2 from GitHub")
    rc, lines = run(["git", "clone", "--recurse-submodules", DRIVER_URL, dest], env=genv)
    if rc != 0:
        text = "\n".join(lines).lower()
        if any(p in text for p in ("could not resolve", "unable to access", "failed to connect",
                                   "network is unreachable", "timed out")):
            hint("no-network", "Could not reach GitHub. Check your internet connection and try again.")
            raise Fail("Downloading the driver failed. Check your internet connection.")
        raise Fail("Downloading the driver failed. The log above has the details.")
    for cmd in (["git", "-C", dest, "checkout", "-q", "--detach", DRIVER_COMMIT],
                ["git", "-C", dest, "submodule", "update", "--init", "--recursive"]):
        rc, _ = run(cmd, env=genv)
        if rc != 0:
            raise Fail("Could not check out the tested driver version.")
    if DRY:
        dry(f"check that git rev-parse HEAD is {DRIVER_COMMIT}")
    else:
        rc, head = query(["git", "-C", dest, "rev-parse", "HEAD"], env=genv)
        if rc != 0 or head.strip() != DRIVER_COMMIT:
            raise Fail(f"The downloaded driver is not the tested version (got {head.strip() or 'nothing'}).")
        _, sub = query(["git", "-C", dest, "submodule", "status", "--recursive"], env=genv)
        if not sub.strip() or any(l[:1] in "-+U" for l in sub.splitlines() if l):
            raise Fail("The driver's hid-tminit part did not download correctly.")
        log("Got hid-tmff2 at commit " + DRIVER_COMMIT[:7])
    return dest


