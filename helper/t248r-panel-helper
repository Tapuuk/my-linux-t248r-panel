class Fail(Exception):
    pass


# ---------------------------------------------------------------- output

def _out(line):
    try:
        sys.stdout.write(line + "\n")
        sys.stdout.flush()
    except BrokenPipeError:
        # The app went away. Keep working so the system is not left half done.
        try:
            sys.stdout = open(os.devnull, "w")
        except OSError:
            pass


def _one_line(text):
    return " ".join(str(text).split())


def log(text=""):
    for line in str(text).splitlines() or [""]:
        _out(" " + line if line.startswith("@@") else line)


def step(sid, state, text):
    _out(f"@@step {sid} {state} {_one_line(text)}")


def hint(code, text):
    _out(f"@@hint {code} {_one_line(text)}")


def dry(text):
    log("[dry-run] " + text)


# ---------------------------------------------------------------- commands and files

_ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")


def _env(extra=None):
    env = dict(os.environ)
    env["PATH"] = SAFE_PATH + (":" + os.environ.get("PATH", "") if DRY else "")
    env.pop("PYTHONPATH", None)
    if extra:
        env.update(extra)
    return env


def which(name):
    return shutil.which(name, path=_env()["PATH"])


def query(cmd, env=None):
    """Run a read-only command and return (exit code, output). Runs in dry-run too."""
    try:
        p = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                           stdin=subprocess.DEVNULL, env=_env(env), text=True, errors="replace")
        return p.returncode, p.stdout
    except OSError:
        return 127, ""


def run(cmd, env=None, cwd=None, log_path=None, quiet=False):
    """Run a command that changes the system, streaming its output as log lines.

    Returns (exit code, output lines). In dry-run it only prints the command.
    """
    shown = shlex.join(cmd)
    if cwd:
        shown = f"(in {cwd}) {shown}"
    if DRY:
        dry("run: " + shown)
        return 0, []
    if not quiet:
        log("$ " + shown)
    lines = []
    logf = open(log_path, "w") if log_path else None
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             stdin=subprocess.DEVNULL, env=_env(env), cwd=cwd)
    except OSError as e:
        if logf:
            logf.close()
        log(f"Could not run {cmd[0]}: {e.strerror}")
        return 127, []
    for raw in p.stdout:
        text = raw.decode("utf-8", "replace").rstrip("\r\n")
        if logf:
            logf.write(text + "\n")
        text = _ANSI.sub("", text.split("\r")[-1]).rstrip()
        if not text:
            continue
        lines.append(text)
        if not quiet:
            log(text)
    rc = p.wait()
    if logf:
        logf.close()
    return rc, lines


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def write_file(path, content, mode=0o644):
    if DRY:
        dry(f"write {path} (mode {mode:o}):")
        for line in content.rstrip("\n").splitlines():
            dry("  | " + line)
        return
    d = os.path.dirname(path)
    os.makedirs(d, mode=0o755, exist_ok=True)
    tmp = os.path.join(d, "." + os.path.basename(path) + ".tmp")
    with open(tmp, "w") as f:
        f.write(content)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def write_sysfs(path, value):
    if DRY:
        dry(f"write '{value}' to {path}")
        return
    with open(path, "w") as f:
        f.write(str(value))


def remove_path(path):
    """Remove a file, symlink or directory tree. Never follows a symlink."""
    if not os.path.lexists(path):
        return False
    if DRY:
        dry("remove " + path)
        return True
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path)
    else:
        os.unlink(path)
    return True


def copy_tree(src, dst):
    if DRY:
        dry(f"copy {src} to {dst} (without .git)")
        return
    shutil.copytree(src, dst, symlinks=True, ignore=shutil.ignore_patterns(".git"))


# ---------------------------------------------------------------- system facts

def os_release():
    info = {}
    for path in ("/etc/os-release", "/usr/lib/os-release"):
        text = read(path)
        if text is None:
            continue
        for line in text.splitlines():
            m = re.match(r"^([A-Z_]+)=(.*)$", line.strip())
            if m:
                v = m.group(2).strip()
                if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                    v = v[1:-1]
                info[m.group(1)] = v
        break
    return info


FAMILY_IDS = {
    "arch": {"arch", "archarm", "cachyos", "endeavouros", "manjaro", "manjaro-arm", "garuda",
             "artix", "arcolinux", "rebornos", "biglinux", "parabola", "steamos"},
    "debian": {"debian", "ubuntu", "linuxmint", "pop", "zorin", "elementary", "neon", "kali",
               "raspbian", "pureos", "mx", "deepin", "tuxedo", "lmde"},
    "fedora": {"fedora", "nobara", "ultramarine", "rhel", "centos", "rocky", "almalinux"},
    "suse": {"opensuse", "opensuse-tumbleweed", "opensuse-leap", "opensuse-slowroll", "suse",
             "sles"},
}


def detect_family(info=None):
    info = info if info is not None else os_release()
    ids = [info.get("ID", "").lower()] + info.get("ID_LIKE", "").lower().split()
    for token in ids:
        for fam, names in FAMILY_IDS.items():
            if token in names:
                return fam
    for token in ids:
        if token.startswith("opensuse"):
            return "suse"
    return "unknown"


def _readonly(path):
    try:
        return bool(os.statvfs(path).f_flag & os.ST_RDONLY)
    except OSError:
        return False


def detect_immutable(info=None):
    """Returns a short reason when the system can't take new packages, else None."""
    info = info if info is not None else os_release()
    os_id = info.get("ID", "").lower()
    like = info.get("ID_LIKE", "").lower().split()
    name = info.get("NAME", os_id or "This system")
    if os.path.exists("/run/ostree-booted"):
        return f"{name} is an image-based system (ostree)"
    if os_id == "steamos":
        return "SteamOS resets system changes on every update"
    if os_id in ("nixos",):
        return "NixOS is set up through its configuration, not by installing packages"
    if any(x in ("opensuse-microos", "microos") or "aeon" in x or "kalpa" in x
           for x in [os_id] + like) or os.path.exists("/usr/sbin/transactional-update"):
        return f"{name} uses transactional updates"
    if os.path.exists("/usr/bin/abroot"):
        return f"{name} is an image-based system (ABRoot)"
    if _readonly("/usr") or _readonly("/"):
        return "the system folders are read-only"
    return None


def build_dir():
    return f"/lib/modules/{KVER}/build"


def kernel_is_clang():
    cfg = read(f"{build_dir()}/.config", "")
    if "CONFIG_CC_IS_CLANG=y" in cfg:
        return True
    return "clang" in (read("/proc/version", "") or "")


def sig_enforced():
    """True when the kernel refuses modules it can't verify."""
    if read("/sys/module/module/parameters/sig_enforce") == "Y":
        return True
    lock = read("/sys/kernel/security/lockdown")
    return bool(lock) and "[none]" not in lock


def secureboot_hint():
    if os.path.exists(MOK_PUB):
        hint("secureboot", "Your kernel only loads signed drivers. DKMS signed this one with its own key, "
             "which your PC does not trust yet. Run: sudo mokutil --import /var/lib/dkms/mok.pub "
             "and choose a one-time password. Reboot, pick Enroll MOK on the blue screen, "
             "enter that password, then run setup again.")
    else:
        hint("secureboot", "Your kernel only loads signed drivers and this one is not signed with a key "
             "your PC trusts. Sign it with your own Secure Boot key (for example with sbctl or a MOK), "
             "or turn off Secure Boot in your firmware settings, then run setup again.")


def mok_enrolled():
    if not which("mokutil") or not os.path.exists(MOK_PUB):
        return None
    _, out = query(["mokutil", "--test-key", MOK_PUB])
    if "already enrolled" in out:
        return True
    if "not enrolled" in out:
        return False
    return None


