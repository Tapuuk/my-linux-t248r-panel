def udev_reload():
    run(["udevadm", "control", "--reload"])
    devs = list(usb_devices())
    for d in devs:
        run(["udevadm", "trigger", "--action=change", "--parent-match=" + d])
    if not devs:
        run(["udevadm", "trigger", "--action=change", "--subsystem-match=usb",
             "--attr-match=idVendor=" + VENDOR])
    run(["udevadm", "settle", "--timeout=5"], quiet=True)


def root_only_writable(path):
    """True if no one but root can change the file or any folder above it."""
    path = os.path.realpath(path)
    while True:
        try:
            st = os.stat(path)
        except OSError:
            return False
        if st.st_uid != 0 or st.st_mode & 0o022:
            return False
        parent = os.path.dirname(path)
        if parent == path:
            return True
        path = parent


def do_rules(auto_pc):
    if auto_pc and not re.fullmatch(r"/[A-Za-z0-9/._+-]+", HELPER):
        log("The helper's path has characters udev can't handle, so automatic PC mode switching is off.")
        auto_pc = False
    # udev would run this file as root on every plug-in, so it must not be user-editable.
    pkg = os.path.join(os.path.dirname(HELPER), "t248rpanel", "usbctl.py")
    if auto_pc and not (root_only_writable(HELPER) and root_only_writable(pkg)):
        log("The helper isn't installed in a system folder, so automatic PC mode switching is off.")
        auto_pc = False
    write_file(RULES_FILE, rules_text(auto_pc))
    udev_reload()
    if auto_pc:
        for d in wheels_in_ps_mode():
            log("The wheel is in PlayStation mode. Switching it to PC mode.")
            try:
                switch_device(d)
            except Fail as e:
                log(str(e))
    note = "" if auto_pc else " Automatic PC mode switching is off."
    return "done", "Device rules are in place." + note + (" (dry run)" if DRY else "")


# ---------------------------------------------------------------- options

def parse_options_file(path=OPTIONS_FILE):
    vals = {}
    text = read(path)
    if text is None:
        return None
    for line in text.splitlines():
        parts = line.split("#", 1)[0].split()
        if len(parts) < 2 or parts[0] != "options" or parts[1].replace("_", "-") != MODULE:
            continue
        for tok in parts[2:]:
            k, sep, v = tok.partition("=")
            if sep and k in OPTION_RANGES and re.fullmatch(r"[0-9]{1,5}", v):
                lo, hi = OPTION_RANGES[k]
                if lo <= int(v) <= hi:
                    vals[k] = int(v)
    return vals


def options_text(vals):
    body = " ".join(f"{k}={vals[k]}" for k in OPTION_RANGES if k in vals)
    return ("# My Linux T248R Panel. Driver defaults for hid-tmff2, read when the driver loads.\n"
            f"options {MODULE} {body}\n")


def note_other_option_files():
    for f in sorted(glob.glob("/etc/modprobe.d/*.conf")):
        if f == OPTIONS_FILE:
            continue
        text = read(f, "")
        if re.search(r"^\s*options\s+hid[-_]tmff[-_]new\b", text, re.M):
            log(f"Note: {f} also sets options for this driver.")


def do_options_setup():
    if os.path.exists(OPTIONS_FILE):
        known = parse_options_file() or {}
        words = " ".join(l.split("#", 1)[0] for l in read(OPTIONS_FILE, "").splitlines()).split()
        stale = [w.split("=", 1)[0] for w in words if "=" in w and w.split("=", 1)[0] not in OPTION_RANGES]
        if not stale:
            return "skipped", "Keeping your saved driver settings."
        write_file(OPTIONS_FILE, options_text({**OPTION_DEFAULTS, **known}))
        return "done", f"Kept your settings and removed ones the driver no longer uses ({', '.join(stale)})."
    write_file(OPTIONS_FILE, options_text(OPTION_DEFAULTS))
    note_other_option_files()
    return "done", "Saved default driver settings." + (" (dry run)" if DRY else "")


def apply_live(given):
    if not os.path.isdir(MODULE_SYS):
        return
    for k in MODULE_PARAMS:
        if k in given:
            p = f"{MODULE_SYS}/parameters/{k}"
            if not os.path.exists(p):
                log(f"The loaded driver is too old for {k}. Run setup to update it.")
                continue
            try:
                write_sysfs(p, given[k])
                log(f"Set {k} to {given[k]} now.")
            except OSError as e:
                log(f"Could not set {k} now: {e.strerror}")
    for hid in pc_hid_devices():
        if driver_of(hid) != HID_DRIVER:
            continue
        for k in TUNABLES:
            p = f"{hid}/{k}"
            if k in given and os.path.exists(p):
                try:
                    write_sysfs(p, given[k])
                    log(f"Set {k} to {given[k]} on the wheel now.")
                except OSError as e:
                    log(f"Could not set {k} on the wheel now: {e.strerror}")


def do_write_options(given):
    vals = parse_options_file()
    if vals is None:
        vals = dict(OPTION_DEFAULTS)
    vals.update(given)
    write_file(OPTIONS_FILE, options_text(vals))
    note_other_option_files()
    apply_live(given)
    return "done", "Driver settings saved." + (" (dry run)" if DRY else "")


# ---------------------------------------------------------------- activate

def loaded_is_stale():
    """True when the loaded driver is an older build of ours than the one on disk."""
    if not os.path.isdir(MODULE_SYS) or not module_path() or foreign_driver():
        return False
    if DRY and DRY_NEW_DRIVER:
        return True
    live = read(f"{MODULE_SYS}/srcversion")
    _, disk = query(["modinfo", "-k", KVER, "-F", "srcversion", MODULE])
    if live and disk.strip():
        return live != disk.strip()
    # The old patched build had an extra parameter; seeing it loaded means a reload is due.
    return os.path.exists(f"{MODULE_SYS}/parameters/plain_encoders")


def do_activate():
    if not module_path() and not os.path.isdir(MODULE_SYS):
        if not DRY:
            raise Fail("The driver is not installed yet.")
        dry("the driver is not installed here; continuing as if it were")
    reload = loaded_is_stale()
    if reload:
        log("The loaded driver is an older version. Reloading it.")
        rc, _ = run(["rmmod", "hid_tmff_new"])
        if rc != 0:
            hint("reboot", "The old driver is still in use. Restart your computer to load the new one.")
            return "done", "Force feedback works, but the new driver loads after a restart."
        if not DRY:
            wait_for(lambda: not os.path.isdir(MODULE_SYS), 3)
    if reload or not os.path.isdir(MODULE_SYS):
        rc, lines = run(["modprobe", MODULE])
        if rc != 0:
            text = "\n".join(lines).lower()
            if "key was rejected" in text or "required key not available" in text:
                secureboot_hint()
                raise Fail("The kernel refused the driver because it is not signed with a trusted key.")
            if "exec format error" in text or "invalid module format" in text:
                hint("reboot", "The driver was built for a different kernel. Restart your computer, "
                     "then run setup again.")
                raise Fail("The driver doesn't match the running kernel.")
            raise Fail("Loading the driver failed. The log above has the details.")
    if not DRY and not wait_for(lambda: os.path.isdir(f"/sys/bus/hid/drivers/{HID_DRIVER}"), 3):
        raise Fail("The driver loaded but did not register with the HID system.")

    if not pc_hid_devices() and wheels_in_ps_mode() and not DRY:
        log("Waiting for the wheel to come back in PC mode...")
        wait_for(lambda: bool(pc_hid_devices()), 8)
    devs = pc_hid_devices()
    if not devs:
        if wheels_in_ps_mode():
            return "skipped", "Driver loaded. The wheel is in PlayStation mode; switch it to PC mode."
        return "skipped", "Driver loaded. Plug in the wheel to use it."

    # The HID core usually moves the wheel to tmff2 by itself right after modprobe.
    if not DRY:
        wait_for(lambda: all(driver_of(d) == HID_DRIVER for d in devs), 1.5)
    for d in devs:
        name = os.path.basename(d)
        drv = driver_of(d)
        if drv == HID_DRIVER:
            continue
        if drv not in (None, "hid-generic"):
            raise Fail(f"The wheel is used by another driver ({drv}). Unplug it and plug it back in.")
        log(f"Moving {name} from {drv or 'no driver'} to {HID_DRIVER}")
        try:
            if drv:
                write_sysfs(f"/sys/bus/hid/drivers/{drv}/unbind", name)
            write_sysfs(f"/sys/bus/hid/drivers/{HID_DRIVER}/bind", name)
        except OSError as e:
            log(f"Rebinding {name} failed: {e.strerror}")
    if DRY:
        return "done", "Force feedback would be ready (dry run)."
    wait_for(lambda: all(driver_of(d) == HID_DRIVER for d in pc_hid_devices()), 2)
    left = [d for d in pc_hid_devices() if driver_of(d) != HID_DRIVER]
    if left:
        raise Fail(f"The wheel is still on {driver_of(left[0]) or 'no driver'}. "
                   "Unplug it and plug it back in.")
    return "done", "Force feedback is ready."


# ---------------------------------------------------------------- switch to PC mode

def switch_device(d):
    """Send the PC mode command to a validated sysfs USB device dir."""
    pid = read(f"{d}/idProduct")
    if read(f"{d}/idVendor") != VENDOR or read(f"{d}/bcdDevice") != T248R_BCD:
        raise Fail("That device is not a T248R.")
    if pid == PC_PID:
        return "skipped", "The wheel is already in PC mode."
    if pid not in PS_PIDS:
        raise Fail("That device is not a T248R.")
    bus, dev = int(read(f"{d}/busnum")), int(read(f"{d}/devnum"))
    node = f"/dev/bus/usb/{bus:03d}/{dev:03d}"
    if DRY:
        dry(f"send control transfer 0x41/0x53 wValue 0x000b to {node}")
        return "done", "Switch command would be sent (dry run)."
    usbctl = _usbctl()
    try:
        usbctl.switch_to_pc_mode(usbctl.node_path(bus, dev))
    except OSError as e:
        # The wheel may drop off the bus before it acknowledges the request.
        if e.errno not in (errno.ENODEV, errno.ESHUTDOWN, errno.EPROTO, errno.EPIPE):
            raise Fail(f"Sending the switch command failed: {e.strerror}")
    return "done", "Switch command sent. The wheel reconnects in PC mode."


def _usbctl():
    here = os.path.dirname(HELPER)
    for base in (here, os.path.dirname(here)):
        if os.path.exists(os.path.join(base, "t248rpanel", "usbctl.py")):
            if base not in sys.path:
                sys.path.insert(0, base)
            break
    else:
        raise Fail("Could not find the t248rpanel package next to the helper.")
    from t248rpanel import usbctl
    return usbctl


def do_switch(bus, dev):
    for d in glob.glob("/sys/bus/usb/devices/*"):
        b, n = read(f"{d}/busnum"), read(f"{d}/devnum")
        if b and n and b.isdigit() and n.isdigit() and int(b) == bus and int(n) == dev:
            return switch_device(d)
    raise Fail(f"No USB device at bus {bus} device {dev}.")


# ---------------------------------------------------------------- uninstall

def do_uninstall():
    removed = False
    for ver in our_dkms_versions():
        log(f"Removing DKMS module {DKMS_NAME} {ver}")
        remove_our_dkms(ver)
        removed = True
    for d in sorted(glob.glob(f"/lib/modules/*/{PLAIN_SUBDIR}")):
        if not os.path.exists(os.path.join(d, MARKER)):
            continue
        kver = d.split("/")[3]
        log(f"Removing the driver built for kernel {kver}")
        remove_path(d)
        if os.path.exists(f"/lib/modules/{kver}/modules.dep"):
            run(["depmod", "-a", kver])
        removed = True
    for f in (RULES_FILE, OPTIONS_FILE):
        if remove_path(f):
            log("Removed " + f)
            removed = True
    if remove_path(WORK_DIR):
        removed = True

    if os.path.isdir(MODULE_SYS):
        if module_path() and not DRY:
            log("Leaving the hid-tmff2 driver from another source loaded.")
        else:
            rc, _ = run(["rmmod", "hid_tmff_new"])
            if rc != 0:
                hint("reboot", "The driver is still in use. Restart your computer to unload it.")
            else:
                # Give the wheel back to hid-generic so input keeps working.
                for d in pc_hid_devices():
                    if not driver_of(d):
                        try:
                            write_sysfs("/sys/bus/hid/drivers_probe", os.path.basename(d))
                        except OSError:
                            pass
            removed = True
    run(["udevadm", "control", "--reload"])
    if DRY:
        return "done", "Everything would be removed (dry run)."
    return "done", "Removed the driver and settings." if removed else "Nothing to remove."


# ---------------------------------------------------------------- main

STEP_TITLES = {
    "tools": "Installing build tools",
    "driver": "Installing the force feedback driver",
    "rules": "Writing device rules",
    "options": "Saving driver settings",
    "activate": "Loading the driver",
    "uninstall": "Removing the driver and settings",
    "switch": "Switching the wheel to PC mode",
}


def run_step(sid, fn, *args):
    step(sid, "running", STEP_TITLES[sid])
    try:
        state, text = fn(*args)
    except Fail as e:
        step(sid, "failed", str(e))
        return False
    except Exception as e:  # keep the protocol intact on bugs
        import traceback
        for line in traceback.format_exc().splitlines():
            log(line)
        step(sid, "failed", f"Unexpected error: {e}")
        return False
    step(sid, state, text)
    return True


def usage():
    return f"""Usage: {os.path.basename(HELPER)} [--dry-run] <command> [args]

Commands:
  setup [--no-auto-pc]          install tools, driver, rules and settings, then load the driver
  install-tools                 install git, make, gcc, dkms and headers for kernel {KVER}
  install-driver                download and install hid-tmff2 {DRIVER_COMMIT[:7]} ({DKMS_VERSION})
  install-rules [--no-auto-pc]  write the udev rules
  write-options key=value...    save driver settings: {", ".join(OPTION_RANGES)}
  activate                      load the driver and move the wheel to it
  switch-to-pc BUSNUM DEVNUM    switch a T248R in PlayStation mode to PC mode
  uninstall                     remove everything this helper installed

--dry-run prints what would be done without changing anything. It works without root.
"""


def die_usage(msg):
    sys.stderr.write(msg + "\n\n" + usage())
    sys.exit(2)


def parse_int(text, lo, hi, what):
    if not re.fullmatch(r"[0-9]{1,5}", text or "") or not lo <= int(text) <= hi:
        die_usage(f"{what} must be a whole number from {lo} to {hi}.")
    return int(text)


def parse_options_args(args):
    if not args:
        die_usage("write-options needs at least one key=value.")
    given = {}
    for a in args:
        k, sep, v = a.partition("=")
        if not sep or k not in OPTION_RANGES:
            die_usage(f"Unknown setting '{a}'. Allowed: {', '.join(OPTION_RANGES)}.")
        if k in given:
            die_usage(f"{k} is given twice.")
        lo, hi = OPTION_RANGES[k]
        given[k] = parse_int(v, lo, hi, k)
    return given


def main(argv):
    global DRY
    os.umask(0o022)
    args = [a for a in argv if a != "--dry-run"]
    DRY = len(args) != len(argv)
    if not args or args[0] in ("-h", "--help", "help"):
        sys.stdout.write(usage())
        return 0 if args else 2
    cmd, rest = args[0], args[1:]

    def flag_no_auto_pc():
        if rest not in ([], ["--no-auto-pc"]):
            die_usage(f"{cmd} only takes --no-auto-pc.")
        return not rest

    def no_args():
        if rest:
            die_usage(f"{cmd} takes no arguments.")

    if cmd == "setup":
        plan = [("tools", do_tools), ("driver", do_driver), ("rules", lambda: do_rules(auto)),
                ("options", do_options_setup), ("activate", do_activate)]
        auto = flag_no_auto_pc()
    elif cmd == "install-tools":
        no_args(); plan = [("tools", do_tools)]
    elif cmd == "install-driver":
        no_args(); plan = [("driver", do_driver)]
    elif cmd == "install-rules":
        auto = flag_no_auto_pc(); plan = [("rules", lambda: do_rules(auto))]
    elif cmd == "write-options":
        given = parse_options_args(rest); plan = [("options", lambda: do_write_options(given))]
    elif cmd == "activate":
        no_args(); plan = [("activate", do_activate)]
    elif cmd == "switch-to-pc":
        if len(rest) != 2:
            die_usage("switch-to-pc needs BUSNUM and DEVNUM.")
        bus = parse_int(rest[0], 1, 999, "BUSNUM")
        dev = parse_int(rest[1], 1, 127, "DEVNUM")
        plan = [("switch", lambda: do_switch(bus, dev))]
    elif cmd == "uninstall":
        no_args(); plan = [("uninstall", do_uninstall)]
    else:
        die_usage(f"Unknown command '{cmd}'.")

    if not DRY and os.geteuid() != 0:
        log("This needs root. Run it through pkexec, or add --dry-run to see what it would do.")
        return 1
    if DRY:
        dry(f"helper {HELPER}, kernel {KVER}, distro family {detect_family()}")

    for sid, fn in plan:
        if not run_step(sid, fn):
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
