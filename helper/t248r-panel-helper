def dkms_make_log():
    logs = glob.glob(f"/var/lib/dkms/{DKMS_NAME}/{DKMS_VERSION}/build/make.log")
    logs += glob.glob(f"/var/lib/dkms/{DKMS_NAME}/{DKMS_VERSION}/{KVER}/*/log/make.log")
    return max(logs, key=os.path.getmtime) if logs else None


def show_log_tail(path, n=25):
    if not path or not os.path.exists(path):
        return
    try:
        with open(path, errors="replace") as f:
            tail = f.read().splitlines()[-n:]
    except OSError:
        return
    log(f"Last lines of {path}:")
    for line in tail:
        log("  " + line)


def remove_our_dkms(ver):
    if which("dkms") and any(v == ver for v, _, _ in dkms_status()):
        run(["dkms", "remove", "-m", DKMS_NAME, "-v", ver, "--all"])
    remove_path(src_dir(ver))


def install_dkms(clone):
    dst = src_dir(DKMS_VERSION)
    if os.path.lexists(dst):
        if not is_ours(DKMS_VERSION):
            raise Fail(f"{dst} exists and was not made by this app. Remove it, then try again.")
        remove_our_dkms(DKMS_VERSION)

    copy_tree(clone, dst)
    write_file(os.path.join(dst, "dkms.conf"), DKMS_CONF)
    write_file(os.path.join(dst, MARKER), f"{BUILD_ID}\n")

    base = ["dkms"]
    mv = ["-m", DKMS_NAME, "-v", DKMS_VERSION]
    rc, _ = run(base + ["add"] + mv)
    if rc != 0:
        raise Fail("dkms add failed. The log above has the details.")
    log("Building the driver. This takes a minute.")
    rc, _ = run(base + ["build"] + mv + ["-k", KVER])
    if rc != 0:
        show_log_tail(dkms_make_log())
        remove_our_dkms(DKMS_VERSION)
        raise Fail("Building the driver failed. The end of the build log is above.")
    # Older versions go only after the new one built, so a failed build leaves them working.
    for ver in our_dkms_versions():
        if ver != DKMS_VERSION:
            log(f"Removing older driver version {ver}")
            remove_our_dkms(ver)
    # A build from the no-DKMS fallback would shadow the DKMS one.
    remove_path(plain_dir())
    rc, _ = run(base + ["install"] + mv + ["-k", KVER])
    if rc != 0:
        raise Fail("dkms install failed. The log above has the details.")


def install_plain(clone):
    if not DRY and not os.path.isdir(build_dir()):
        raise Fail(f"Headers for kernel {KVER} are missing. Run the build tools step first.")
    cmd = ["make", f"-j{os.cpu_count() or 2}", f"KDIR={build_dir()}"]
    if kernel_is_clang():
        cmd.append("LLVM=1")
    make_log = os.path.join(WORK_DIR, "make.log")
    log("Building the driver. This takes a minute.")
    rc, _ = run(cmd, cwd=clone, log_path=None if DRY else make_log, quiet=True)
    if rc != 0:
        show_log_tail(make_log)
        raise Fail("Building the driver failed. The end of the build log is above.")
    kos = [os.path.join(clone, "hid-tmff-new.ko"),
           os.path.join(clone, "deps/hid-tminit/hid-tminit-new.ko"),
           os.path.join(clone, "deps/hid-tminit/usb-tminit-new.ko")]
    if not DRY:
        for ko in kos:
            if not os.path.exists(ko):
                raise Fail(f"The build did not produce {os.path.basename(ko)}.")
    dest = plain_dir()
    remove_path(dest)
    if DRY:
        dry(f"create {dest}")
    else:
        os.makedirs(dest, 0o755)
    for ko in kos:
        if DRY:
            dry(f"copy {ko} to {dest}/")
        else:
            shutil.copy2(ko, dest)
            os.chmod(os.path.join(dest, os.path.basename(ko)), 0o644)
    write_file(os.path.join(dest, MARKER), f"{BUILD_ID}\n")
    rc, _ = run(["depmod", "-a", KVER])
    if rc != 0:
        raise Fail("depmod failed. The log above has the details.")
    log("Built without DKMS: run setup again after each kernel update.")


def do_driver():
    global DRY_NEW_DRIVER
    if check_immutable_for_install():
        return "skipped", "The driver is already part of your system."
    other = foreign_driver()
    if other:
        log(f"Found hid-tmff2 from another source: {other}")
        return "skipped", "hid-tmff2 from another source is already installed. Leaving it alone."
    dkms = has_dkms()
    if dkms:
        for ver, kern, state in dkms_status():
            if ver == DKMS_VERSION and kern == KVER and state == "installed" and is_ours(ver):
                remove_path(plain_dir())
                return "skipped", "The driver is already installed for this kernel."
    elif read(os.path.join(plain_dir(), MARKER)) == BUILD_ID and \
            os.path.exists(os.path.join(plain_dir(), "hid-tmff-new.ko")):
        return "skipped", "The driver is already installed for this kernel."

    old = [v for v in our_dkms_versions() if v != DKMS_VERSION]
    if os.path.exists(os.path.join(plain_dir(), MARKER)) and \
            read(os.path.join(plain_dir(), MARKER)) != BUILD_ID:
        old.append("a build without DKMS")
    if old:
        log(f"Updating the driver from {', '.join(old)} to {DKMS_VERSION}.")

    if not which("git") and not DRY:
        raise Fail("git is missing. Run the build tools step first.")
    if not DRY and not os.path.isdir(build_dir()):
        raise Fail(f"Headers for kernel {KVER} are missing. Run the build tools step first.")

    clone = fetch_driver()
    if dkms:
        install_dkms(clone)
    else:
        log("DKMS is not installed, building the driver directly.")
        install_plain(clone)
    if DRY:
        DRY_NEW_DRIVER = True

    if sig_enforced():
        if mok_enrolled() is not True:
            secureboot_hint()
    return "done", "Driver installed for kernel " + KVER + (" (dry run)" if DRY else "")


